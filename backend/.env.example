# ============================================================
# 后端环境变量模板
# 使用方法:把本文件复制一份,改名为 .env,再填入你自己的真实值。
#   cp .env.example .env
# .env 文件会被 .gitignore 忽略,不会上传到代码仓库,因此可以放心放密钥。
# ============================================================

# ---------- LLM配置 (大语言模型,给 Agent 提供"智能") ----------
# 注意:后端通过 ChatOpenAI 读取 LLM_API_KEY / LLM_BASE_URL / LLM_MODEL_ID / LLM_TIMEOUT,
# 所以下面这些变量名才是真正生效的。

# 模型名称(例如 deepseek-chat、gpt-4o 等,取决于你用哪家服务)
LLM_MODEL_ID=your-model-name

# API密钥(去对应的服务商后台申请)
LLM_API_KEY=your-api-key-here

# 服务地址(OpenAI 是 https://api.openai.com/v1;DeepSeek 等有自己的地址)
LLM_BASE_URL=your-api-base-url

# 超时时间(可选,默认60秒)
LLM_TIMEOUT=60

# ---------- 服务器配置 ----------
HOST=0.0.0.0   # 监听地址,0.0.0.0 表示局域网也能访问
PORT=8000      # 监听端口

# ---------- CORS配置(允许哪些前端地址访问) ----------
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ---------- 日志级别 ----------
LOG_LEVEL=INFO

# ---------- Unsplash 图片服务(可选) ----------
UNSPLASH_ACCESS_KEY=""
UNSPLASH_SECRET_KEY=""

# ---------- 高德地图API配置(必填) ----------
# 去 https://lbs.amap.com/ 申请"Web服务"类型的 Key,填到下面
AMAP_API_KEY=your_amap_api_key_here

# ---------- 千问 Embedding API 配置(RAG 向量化,可选但推荐) ----------
# 去 https://bailian.console.aliyun.com/ 开通"文本向量化"并获取 API Key
DASHSCOPE_API_KEY=your_dashscope_api_key_here

# Embedding 模型名(千问 text-embedding-v3,支持中文)
EMBEDDING_MODEL=text-embedding-v3

# OpenAI 兼容端点(一般不用改)
EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# ---------- 认证(JWT)配置 ----------
# JWT 签名密钥:请用一段随机长字符串(可用 `python -c "import secrets; print(secrets.token_urlsafe(48))"` 生成)
JWT_SECRET=please-change-to-a-random-secret
# token 有效期(分钟),默认 10080 = 7 天
JWT_EXPIRE_MINUTES=10080
