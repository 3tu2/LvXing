# ============================================================
# Git 忽略规则:列在这里的文件/文件夹不会被 git 跟踪(不会提交到仓库)。
# 每行是一种"匹配模式",* 代表任意字符。
# 作用:避免把缓存、密钥、依赖包等不该提交的东西传到代码仓库。
# 注意:git 里只有"整行以 # 开头"才是注释,不能写"行尾注释"。
# ============================================================

# ---------- Python 相关的缓存和编译产物 ----------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# ---------- 虚拟环境(依赖装在这里,不需要提交) ----------
venv/
env/
ENV/
.venv

# ---------- 环境变量文件(里面是密钥,绝不能提交) ----------
.env
.env.local

# ---------- 编辑器/IDE 的本地配置 ----------
.vscode/
.idea/
*.swp
*.swo
*~

# ---------- 日志文件 ----------
*.log

# ---------- 测试产物 ----------
.pytest_cache/
.coverage
htmlcov/

# ---------- 操作系统自动生成的文件 ----------
.DS_Store
Thumbs.db
