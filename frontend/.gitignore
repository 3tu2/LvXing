# ============================================================
# Git 忽略规则:列在这里的文件/文件夹不会被 git 跟踪(不提交到仓库)。
# 注意:git 里只有"整行以 # 开头"才是注释,不能写"行尾注释"。
# ============================================================

# ---------- 日志文件 ----------
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ---------- 依赖和构建产物(体积大,且能重新生成,不需提交) ----------
node_modules
dist
dist-ssr
*.local

# ---------- 编辑器/IDE 相关 ----------
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# ---------- 环境变量(本地密钥,不能提交) ----------
.env
.env.local
.env.*.local
