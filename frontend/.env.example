# ============================================================
# 前端环境变量模板
# 使用方法:把本文件复制一份,改名为 .env,再填入真实值:
#   cp .env.example .env
# 注意:只有以 VITE_ 开头的变量才会被 Vite 暴露给前端代码使用
# (在代码里通过 import.meta.env.XXX 读取)。
# ============================================================

# 后端API地址(前端发请求时用的后端地址)
VITE_API_BASE_URL=http://localhost:8000

# 高德地图 Web API Key(注意:目前代码里主要用的是下面那个 JS API Key)
VITE_AMAP_WEB_KEY=your_amap_web_api_key_here

# 高德地图 Web端 JS API Key(结果页加载地图时用,必填)
# 去 https://lbs.amap.com/ 申请"Web端(JS API)"类型的 Key
VITE_AMAP_WEB_JS_KEY=your_amap_web_js_key_here
